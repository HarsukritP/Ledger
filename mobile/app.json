{
  "expo": {
    "name": "Ledger",
    "slug": "ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ledger",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ledger.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      },
      "package": "com.ledger.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#09090B",
      "themeColor": "#09090B",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-auth0",
        {
          "domain": "dev-rlqpb3p7hzb1ldkr.us.auth0.com"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "eeadfc00-6004-4a15-89c3-8d43452e09b8"
      }
    },
    "owner": "saswath06"
  }
}
