{
  "expo": {
    "name": "Ledger",
    "slug": "ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ledger",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ledger.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      },
      "package": "com.ledger.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#09090B"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-auth0",
        {
          "domain": "dev-rlqpb3p7hzb1ldkr.us.auth0.com"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
